PORT=8000

# Postgres connection strings (Neon: pooled for the app, unpooled for migrations)
# See prisma7.config.ts (uses DATABASE_URL_UNPOOLED for CLI/migrations)
# and src/config/prisma.ts (uses DATABASE_URL for the running app)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

JWT_SECRET="replace-with-a-long-random-string"
